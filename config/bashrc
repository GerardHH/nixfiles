#!/bin/bash

# Allow dynamic sourcing in known locations
#shellcheck disable=SC1090,SC1091

# Nix
for _nix_profile in \
    /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh \
    /nix/var/nix/profiles/default/etc/profile.d/nix.sh \
    "$HOME/.nix-profile/etc/profile.d/nix.sh"; do
    [ -f "$_nix_profile" ] && . "$_nix_profile" && break
done
unset _nix_profile

[ -f "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ] &&
    . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"

# pre-commit rejects executables under $HOME as "not system" and falls back to
# downloading its own node. The profile's store path is outside $HOME, so the
# same binaries qualify.
export PATH="$(readlink --canonicalize "$HOME/.nix-profile")/bin:$PATH"

# INFO If not running interactively, then only source and skip the rest
[[ $- != *i* ]] && return

# Completions
for _bc in \
    "$HOME/.nix-profile/share/bash-completion/bash_completion" \
    /etc/profile.d/bash_completion.sh; do
    [ -r "$_bc" ] && source "$_bc" && break
done
unset _bc

source "${XDG_CONFIG_HOME:-$HOME/.config}/bash/eza.sh"
source "${XDG_CONFIG_HOME:-$HOME/.config}/bash/history_config.sh"
source "${XDG_CONFIG_HOME:-$HOME/.config}/fzf/fzf.sh"

# Aliases
alias ld='lazydocker'
alias lg='lazygit'
alias top='btop'
alias vi='nvim'

# Exports
export EDITOR="nvim"
export RIPGREP_CONFIG_PATH="$HOME/.ripgreprc"
export NAVI_PATH="$HOME/.config/navi/cheats"
export PRE_COMMIT_HOME="${HOME}/.cache/pre-commit" # Force pre-commit to look at consolidated cache
export SHELL="${SHELL:-${BASH:-/bin/bash}}"        # Export SHELL in case it didn't get set in container - fzf preview

# Which nix-home-manager profile is active. Used by oh-my-posh for instance
_nixfiles_profile_file="${XDG_CONFIG_HOME:-$HOME/.config}/nixfiles/profile"
if [ -r "$_nixfiles_profile_file" ]; then
    read -r NIXFILES_PROFILE <"$_nixfiles_profile_file" || true
    export NIXFILES_PROFILE
fi
unset _nixfiles_profile_file

# Start up executions
oh-my-posh disable notice

# Shell integrations
eval "$(navi widget bash)"
eval "$(zoxide init --cmd cd bash)"
eval "$(oh-my-posh init bash --config ~/.config/oh-my-posh/theme.toml)"
source <(carapace _carapace bash)
